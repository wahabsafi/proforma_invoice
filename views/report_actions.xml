<odoo>
    <record id="action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="name">Proforma Invoice PDF</field>
        <field name="model">sale.order</field>
        <field name="report_name">proforma_invoice.report_saleorder_pro_forma</field>
        <field name="report_file">proforma_invoice.report_saleorder_pro_forma</field>
        <field name="report_type">qweb-pdf</field>
        <field name="print_report_name">'Proforma_' + (object.name or '')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="proforma_invoice.official_paper_format"/>
    </record>
    <record id="action_report_pro_forma_invoice_view" model="ir.actions.report">
        <field name="name">viewProforma Invoice</field>
        <field name="model">sale.order</field>
        <field name="report_name">proforma_invoice.report_saleorder_pro_forma</field>
        <field name="report_file">proforma_invoice.report_saleorder_pro_forma</field>
        <field name="report_type">qweb-html</field>
        <field name="print_report_name">'Proforma_' + (object.name or '')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
    
</odoo>
